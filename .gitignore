# macOS 系统文件
.DS_Store

# Python 缓存
__pycache__/
*.py[cod]
*.pyo
*.so

# 虚拟环境目录（无论你是否用 .venv）
.venv/
venv/
env/

# pip 缓存与构建输出
*.egg-info/
dist/
build/
.eggs/

# 日志、运行时文件
*.log
*.pid
*.sqlite3
*.db

# 本地配置文件（如 Flask 密钥、API 密钥）
.env
.env.*

# PyCharm 配置文件
.idea/

# VSCode（如你偶尔使用 VSCode）
.vscode/

# Jupyter Notebook checkpoint（如果有）
.ipynb_checkpoints/

# 项目临时文件
*.tmp
*.bak
*.swp
*.swo

# 用户上传文件目录
uploads/
app/static/uploads/

# 本地数据库和初始化脚本不纳入版本管理
init_all.sh
db_reset.py
reset_db.sh
.coverage
app.log.*
config_templates/
logs/